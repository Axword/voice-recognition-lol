# Generated test material
tests/reports/

# Pelny zestaw audio (okolo 1400 plikow) jest generowany i cache'owany w CI.
# Wyjatkiem jest maly zestaw smoke: 10 bohaterow x 4 umiejetnosci x 2 jezyki,
# ktory siedzi w repo, zeby testy e2e chodzily na kazdym PR.
tests/fixtures/audio/**
!tests/fixtures/audio/*/
!tests/fixtures/audio/*/manifest.json
!tests/fixtures/audio/*/*/
tests/fixtures/audio/*/*/*.mp3
!tests/fixtures/audio/*/Aatrox/*.mp3
!tests/fixtures/audio/*/Ahri/*.mp3
!tests/fixtures/audio/*/Garen/*.mp3
!tests/fixtures/audio/*/Hwei/*.mp3
!tests/fixtures/audio/*/Jinx/*.mp3
!tests/fixtures/audio/*/Katarina/*.mp3
!tests/fixtures/audio/*/Lux/*.mp3
!tests/fixtures/audio/*/Thresh/*.mp3
!tests/fixtures/audio/*/Yasuo/*.mp3
!tests/fixtures/audio/*/Zed/*.mp3
# Komendy glosowe per jezyk: maly zestaw TTS, po 6 fraz na jezyk
!tests/fixtures/audio/commands/*/*.mp3

# Claude Code worktrees and agents
.claude/
